{
  "name": "prts-discord-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Unofficial Arknights-themed Discord bot with a Claude Code narrator bridge",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "bun install --no-summary && bun src/bot.ts",
    "bridge": "bun src/server.ts",
    "dry-run": "bun src/bot.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format --write .",
    "check": "tsc --noEmit && bun test && bun src/bot.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.14.0",
    "opusscript": "^0.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
