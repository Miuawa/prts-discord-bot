# PRTS settings. Copy to .env (git ignores it) and edit.
# The bot reads, in this order (first one wins): the real environment, this
# repo's .env, then ~/.claude/channels/discord/.env. On Linux, the systemd
# units also load this .env.
#
# Secrets (the Discord token, API keys) are best kept OUT of this folder, in
# ~/.claude/channels/discord/.env: a Claude Code narrator works in this folder
# and could read them here.

# ── Discord ──────────────────────────────────────────────────────────────
#DISCORD_BOT_TOKEN=
# Where access.json, bridge.key and the attachment inbox live. Set it in the
# real environment if you change it (the .env files are found through it).
#DISCORD_STATE_DIR=~/.claude/channels/discord
# static = read access.json once at start and never write it (no pairing).
#DISCORD_ACCESS_MODE=

# ── Who answers /prts ────────────────────────────────────────────────────
# claude-code        the Claude Code narrator session (Pro/Max plan), default
# anthropic          the Anthropic API (needs ANTHROPIC_API_KEY)
# openai-compatible  any OpenAI-style server: llama.cpp, Ollama, LM Studio, OpenRouter, ...
# auto               claude-code while the narrator is connected, else PRTS_AUTO_FALLBACK
PRTS_BACKEND=claude-code
#PRTS_AUTO_FALLBACK=openai-compatible
# Model id for the API backend (anthropic default: claude-sonnet-5-5).
#PRTS_MODEL=
# openai-compatible: server URL up to /v1, optional key, sampling, extra JSON body.
#PRTS_BASE_URL=http://127.0.0.1:8081/v1
#PRTS_API_KEY=
#PRTS_TEMPERATURE=0.7
#PRTS_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# anthropic: effort (low | medium | high | xhigh | max) and key.
#PRTS_EFFORT=medium
# anthropic: on = re-run a declined turn on a fallback model chosen by the API.
#PRTS_REFUSAL_FALLBACK=off
#ANTHROPIC_API_KEY=
#PRTS_MAX_TOKENS=
#PRTS_LABEL=
# Seconds to wait for an API model's reply.
#PRTS_TIMEOUT=300
# Images to API models: auto | on | off (local models need an mmproj for vision).
#PRTS_VISION=auto
# Your own persona text for /prts on API backends (a text file).
#PRTS_PERSONA_FILE=

# Model for the narrator session started by the launch scripts (claude-code).
PRTS_NARRATOR_MODEL=sonnet
# Port of the local WebSocket bridge between bot.ts and server.ts (127.0.0.1 only).
#PRTS_BRIDGE_PORT=47823

# ── Add-on modules ───────────────────────────────────────────────────────
# Comma-separated folder names under modules/. Empty = core bot only.
PRTS_MODULES=
#PRTS_MODULES_DIR=./modules

# ── Roleplay module (only read when PRTS_MODULES includes roleplay) ──────
# See modules/roleplay/README.md. Every RP_* AI setting falls back to the
# PRTS_* one above, so set only what should differ for roleplay.
#RP_BACKEND=claude-code
#RP_AUTO_FALLBACK=openai-compatible
#RP_MODEL=
#RP_BASE_URL=
#RP_API_KEY=
#RP_EFFORT=
#RP_TEMPERATURE=
#RP_EXTRA_BODY=
# Discord user IDs (comma-separated) allowed to manage roleplay channels.
#RP_OWNER_IDS=
# Channel IDs registered as roleplay channels on the first run.
#RP_CHANNEL_IDS=
#RP_KIT_DIR=./roleplay-kit
#RP_STORY_LOG=
#RP_BACKUP_DIR=~/PRTS-backups

# ── Local model unit (linux/systemd/llama-server.service) ────────────────
LLAMA_MODEL=<huggingface-user>/<model>-GGUF:<quant>
#LLAMA_HOST=127.0.0.1
#LLAMA_PORT=8081
#LLAMA_ARGS=-c 32768 --parallel 1 -ngl 99 --image-max-tokens 1024

# 1 = write each message sent to the AI and each AI reply to the bot's log
# (journalctl, PRTS Control "Logs"). Off by default: it puts Discord messages in the log.
#PRTS_LOG_CHATS=1

# ── Arknights data ───────────────────────────────────────────────────────
# Folders for downloaded data and caches. Defaults: ./data and ./cache
#PRTS_DATA_DIR=
#PRTS_CACHE_DIR=
#PRTS_STORIES_JSON=
# Command that rebuilds the story index once a day and prints a JSON summary
# (see startStoryRefresh in src/ark/story.ts).
#PRTS_STORY_REFRESH_CMD=
# Automatic posts (new stories, events and banners) go to the channel each server picks with
# /events announce. This optional channel ID always gets them too.
#PRTS_ANNOUNCE_CHANNEL=
# 1 = don't pull the community Google Sheets every 6 hours.
#PRTS_NO_SHEET_REFRESH=1
#PRTS_USER_AGENT=PRTS-Discord-bot/1.0 (unofficial Arknights fan bot)
# Mirror of the EN game data tables (must end in /excel/).
#PRTS_GAMEDATA_URL=https://raw.githubusercontent.com/ArknightsAssets/ArknightsGamedata/master/en/gamedata/excel/

# ── Music ────────────────────────────────────────────────────────────────
#PRTS_MUSIC_DIR=./music
#PRTS_YTDLP=yt-dlp
#PRTS_FFPROBE=ffprobe
