{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": { "ignore": ["node_modules", "cache", "data", "logs", "roleplay-kit", ".claude", "bun.lock"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 200 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all", "arrowParentheses": "asNeeded" }
  },
  "json": { "formatter": { "enabled": true } },
  "linter": { "enabled": false },
  "organizeImports": { "enabled": false }
}
