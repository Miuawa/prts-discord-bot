# Only package.json, bun.lock, tsconfig.json, src/ and modules/ are copied
# into the image. Everything private or local stays out of the build context.
*
!package.json
!bun.lock
!tsconfig.json
!src/
!modules/
# Never, even inside the allowed folders:
**/.env
**/.env.*
**/*.env
**/access.json
**/bridge.key
**/*.key
**/*.pem
**/*token*
**/*secret*
**/node_modules
**/__pycache__
**/*.log
**/*.bak*
modules/control/linux/prts-logo.png
